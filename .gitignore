# ============================================================
#  bookcollector-admin · .gitignore
#
#  发布策略：只发布源码 —— backend/ 与 frontend/ 两个目录。
#  其余一切（文档、脚本、日志、IDE 配置、AI 任务说明等）都不进版本库。
#
#  写法说明：先「忽略根目录下的一切」，再用 ! 白名单放行要发布的路径。
#  ⚠️ 顺序不能颠倒 —— 后面的规则会覆盖前面的。
#  ⚠️ 本文件不支持行尾注释：# 只有出现在行首才算注释。
# ============================================================


# ------------------------------------------------------------
# 1) 忽略根目录下的一切
# ------------------------------------------------------------
/*


# ------------------------------------------------------------
# 2) 白名单：只放行两个源码目录 + 仓库门面
# ------------------------------------------------------------
!/.gitignore
!/README.md
!/backend/
!/frontend/


# ------------------------------------------------------------
# 3) 被排除的根目录内容
#    （第 1 条已全部覆盖，这里显式列出，便于一眼看清排除了什么）
# ------------------------------------------------------------

# 内部文档：需求分析、分步方案、执行进度
/docs/

# 本地启动器与浏览器验收脚本
/tools/

# 运行日志
/logs/

# IDE 工程配置
/.idea/

# README 旧版备份（含本机路径与登录凭据，不可发布）
/v1_bak.md

# 本机一键脚本（与作者机器强绑定）
/start-backend.cmd
/start-frontend.cmd
/stop-all.cmd


# ------------------------------------------------------------
# 4) backend / frontend 内部的构建产物与本地文件
#    （两个目录本身要发布，但下面这些不该进版本库）
# ------------------------------------------------------------

# 构建产物
/backend/target/
/frontend/dist/
/frontend/node_modules/

# Vite 的临时配置文件
/frontend/vite.config.ts.timestamp-*.mjs

# 日志（含 spring-boot:run 落在 backend/ 下的那种）
/backend/logs/
logs/
*.log

# IDE / 编辑器
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 本地覆盖配置：不要把「自己的数据库地址 / 凭据」提交上去
application-local.yml
application-local.properties
.env
.env.local


# ------------------------------------------------------------
# 5) backend/ 下的 AI 任务说明（本地研发用，不进版本库）
# ------------------------------------------------------------
/backend/1_结构调整说明.md
/backend/2_结构调整步骤.md


# ------------------------------------------------------------
# 6) 可选放行 —— 需要时去掉对应行的注释即可
# ------------------------------------------------------------

# !/LICENSE
# !/AGENTS.md
# !/CLAUDE.md
